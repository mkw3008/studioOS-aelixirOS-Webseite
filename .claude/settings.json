{
  "permissions": {
    "deny": [
      "Read(clublaneVision.png)",
      "Read(studioexample.png)",
      "Read(export-sereno/assets/StudioOSVision_Product.png)",
      "Read(export-sereno/assets/Tops.png)",
      "Read(export-sereno/assets/studioexample.png)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --rawfile router \"${CLAUDE_PROJECT_DIR}/_flow/ROUTER.md\" '{hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: $router}, systemMessage: \"Hook aktiv: Flow-Router geladen.\"}' 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Lade Flow-Router..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/_flow/pruefe-flows.sh\" --json 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Pruefe Flow-Blaetter..."
          }
        ]
      }
    ]
  }
}
